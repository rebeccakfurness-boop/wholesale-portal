# Postgres connection string (Vercel Postgres, Supabase, or any Postgres 13+ instance).
# Vercel Postgres: copy the "POSTGRES_URL" value from Storage > your database > .env.local tab.
# Supabase: Project Settings > Database > Connection string (URI, "Transaction" pooler mode).
DATABASE_URL=postgres://user:password@host:5432/database

# Gates /admin (CSV import + account management) behind a single shared
# password — there's no separate staff-accounts concept, just you.
ADMIN_PASSWORD=change-me-to-something-long-and-random
